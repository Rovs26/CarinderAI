# CarinderAI environment variables.
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# See: design.md §Scan_API Detailed Design and §Prisma Schema (full).

# OpenAI API key for /api/scan (Req 7.4, 7.9). The route returns 500 if unset.
OPENAI_API_KEY=

# Prisma SQLite database URL. Defaults to a local dev.db file.
DATABASE_URL=file:./dev.db
